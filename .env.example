# ─── Shopify Storefront API ───────────────────────────────────────────────────
# Create a Custom App in your Shopify Admin → Settings → Apps and sales channels
# Enable Storefront API access with these scopes:
#   - unauthenticated_read_product_listings
#   - unauthenticated_read_collection_listings
#   - unauthenticated_write_checkouts
#   - unauthenticated_read_checkouts
#   - unauthenticated_read_content
#
# Copy the Storefront API access token (public) and your store domain below.
# Then rename this file to .env (never commit .env to version control).

EXPO_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
EXPO_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=your_storefront_public_access_token_here
